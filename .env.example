# Copy this file to .env and edit. Every line is optional.

# ---- LLM brain -------------------------------------------------------------
# "ollama" runs a free open-weight model on your own machine (recommended).
# "openai" talks to any OpenAI-compatible endpoint (many have free tiers).
LLM_BACKEND=ollama

# Ollama (smaller model = faster on CPU, e.g. qwen2.5:3b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI-compatible hosted API (only when LLM_BACKEND=openai).
# Examples of base URLs - check each provider's docs for current free models:
#   https://api.groq.com/openai/v1
#   https://openrouter.ai/api/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=200

# ---- Speech to text (faster-whisper) --------------------------------------
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=int8

# ---- Text to speech (edge-tts) --------------------------------------------
TTS_RATE=+0%

# ---- App --------------------------------------------------------------------
DEFAULT_LANGUAGE=en
MAX_HISTORY_TURNS=12
HOST=127.0.0.1
PORT=8000
